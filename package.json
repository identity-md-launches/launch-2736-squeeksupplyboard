{
  "name": "squeek-supply-station",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/main.js",
    "dev": "node --env-file-if-exists=.env server/main.js",
    "test": "node --test tests/*.test.mjs",
    "test:contracts": "forge test",
    "test:chain": "node scripts/chain-smoke.mjs",
    "check": "node scripts/check.mjs",
    "contracts:build": "forge build",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.mjs",
    "format": "prettier --write \"server/*.js\" \"scripts/*.mjs\" \"tests/*.mjs\" \"squeek-drop-frontend/squeek-drop/js/*.js\" \"squeek-drop-frontend/squeek-drop/index.html\" \"squeek-drop-frontend/squeek-drop/css/*.css\"",
    "build:site": "node --env-file-if-exists=.env scripts/export-site.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@openzeppelin/contracts": "^5.6.1",
    "fastify": "^5.12.7",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
