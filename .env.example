# Node 24+. No credentials are needed for game play, verification and rankings.
PORT=8080
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
DB_PATH=data/squeek.sqlite
SQUEEK_API=https://api.squeekchain.com
SQUEEK_CORE_ADDRESS=0x980b4424c007caf7a1f3670b48c8eaef7ebc3d44
# Set a long random JWT_SECRET in production; local development persists one in SQLite.
JWT_SECRET=
# Optional: enable REAL Sepolia score attestations after deploying the contract.
SEPOLIA_RPC_URL=
BOARD_ADDRESS=
SIGNER_PRIVATE_KEY=
# Only used by the explicit deploy command, never by the game server.
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=
SIGNER_ADDRESS=
